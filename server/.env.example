# 小满 Xiaoman · 本地开发环境
# 复制为 .env 后按需修改。DATABASE_URL 必填。

DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/xiaoman_dev

# 留空 = 不校验（仅限本机）。部署到服务器前必须设一个长随机串。
APP_TOKEN=

# 单用户访问密码（推荐）：只存 scrypt 哈希，不存明文；留空 = 关闭登录。
# 生成：cd server && .venv/bin/python -c "from app.api.auth import make_password_hash; print(make_password_hash('你的密码'))"
APP_PASSWORD_HASH=
APP_SESSION_DAYS=30

# API 与 Pi 网关之间的内部 token（两边必须一致）
INTERNAL_TOKEN=dev-internal-token

# 数据目录（上传图片），相对 server/ 目录
DATA_DIR=../data/uploads

# 前端静态目录（相对 server/ 目录）
WEB_DIR=../web

# 首次启动是否自动建表（生产/迁移环境设为 0，只走 alembic）
AUTO_CREATE=0
# Pi 网关（P2 完成后才建议打开；留空走直连）
PI_GATEWAY=



# ── 阿里云切题（docs/25）────────────────────────────
# appcode：云市场（支持 base64，0.01元/500次试用）
# aksk   ：官方 CutQuestions（每天免费 1000 次，需 OSS 公网图）
PAPERCUT_AUTH=
PAPERCUT_APPCODE=
PAPERCUT_ENDPOINT=
PAPERCUT_WORKSPACE_ID=
# 自动矫正默认开：拍了斜的/弯的页面，算法先拉正再切题；坐标仍按原图返回
PAPERCUT_CORRECT=true
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
